# CHANGE THIS before any shared/deployed use. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DIAGNOVA_SECRET_KEY=replace-this-with-a-long-random-secret
DIAGNOVA_DB_PATH=./data/diagnova.sqlite3
DIAGNOVA_ENABLE_SKIN_MODEL=0
# Model is downloaded from Hugging Face the first time it is enabled.
DIAGNOVA_SKIN_MODEL_REPO=RevelaCap/clinical-skin-condition-v1
